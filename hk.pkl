amends "package://github.com/jdx/hk/releases/download/v1.39.0/hk@1.39.0#/Config.pkl"

// The check commands live in .mise.toml [tasks] so these hooks and CI
// (.github/workflows/ci.yml) share one definition and never drift. Each step
// delegates to `mise run <task>`. The glob skips a step when no matching file
// is staged, but the task itself checks the whole module (not just the staged
// files). Checks no longer auto-fix — apply the fix each task's output hints at.
local linters = new Mapping<String, Step> {
    ["fmt"] = new Step {
        glob = "**/*.go"
        check = "mise run fmt"
    }
    ["vet"] = new Step {
        glob = "**/*.go"
        check = "mise run vet"
    }
    ["tidy"] = new Step {
        glob = "**/go.mod"
        check = "mise run tidy"
    }
}

hooks {
    ["pre-commit"] {
        stash = "git"
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
