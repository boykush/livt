amends "package://github.com/jdx/hk/releases/download/v1.39.0/hk@1.39.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.39.0/hk@1.39.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["go_fmt"] = Builtins.go_fmt
    // The builtin runs `go vet {{files}}`, which fails on commits spanning
    // multiple packages and on test-only changes (files are compiled without
    // the rest of their package). Vet whole packages instead.
    ["go_vet"] = (Builtins.go_vet) {
        check = "go vet ./..."
    }
    ["gomod_tidy"] = Builtins.gomod_tidy
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
